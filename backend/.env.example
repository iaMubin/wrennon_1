# This file lists every environment variable app/config.py's Settings
# class actually reads today. Settings uses pydantic-settings with
# extra="forbid" (the default) — an env var here that Settings doesn't
# define, or a required one missing, crashes the app at import time
# with a ValidationError. Keep this file in sync with config.py when
# either changes; a stale example here caused a same-day onboarding
# crash before (leftover ChromaDB-era keys that no longer exist).

# --- LLM ---
GROQ_API_KEY=your_groq_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
# Optional — only used if you route some calls through OpenRouter/OpenAI
# directly instead of Groq.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Vector store (Pinecone; embeddings via Cohere) ---
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_HOST=your_pinecone_index_host_here
# Local/offline dev without a real Pinecone index: set this literal
# value and vectorstore.py falls back to a small mocked knowledge base
# instead of calling Pinecone/Cohere.
#   PINECONE_API_KEY=YOUR_NEW_PINECONE_API_KEY

# --- Optional: LangSmith tracing ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# --- App ---
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5600,http://127.0.0.1:5600
# In production, APP_ENV=production additionally requires:
#  - JWT_SECRET_KEY to not be the dev default
#  - CORS_ALLOWED_ORIGINS to not be "*"
#  - DATABASE_URL to not be sqlite (Render/most PaaS filesystems are
#    ephemeral — sqlite in prod silently loses all data on redeploy)
# See config.py's validate_production_secrets for the exact checks.

# --- Database ---
# SQLite is fine for local dev only. Use a real Postgres URL for
# staging/production.
DATABASE_URL=sqlite:///./data/wrennon.db

# --- Redis (WebSocket pub/sub across workers, rate limiting) ---
REDIS_URL=redis://localhost:6379
# Local dev without a Redis instance running: this literal value makes
# the app run in single-instance mode without cross-worker broadcast or
# distributed rate limiting (see connection_manager.py / agent.py).
#   REDIS_URL=memory://local

# --- Agent auth ---
# JWT_SECRET_KEY: any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

AGENT_USERNAME=mubin
# AGENT_PASSWORD_HASH: run scripts/generate_agent_password.py and paste
# the output here. Never put the plain password in this file.
AGENT_PASSWORD_HASH=
