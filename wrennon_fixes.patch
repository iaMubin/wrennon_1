+        full_name="CSRF Test Agent",
+        employee_id="TEST-CSRF1",
+        role="agent",
+        password_hash=hash_password("CsrfTest!123"),
+    )
+    db.add(new_agent)
+    db.commit()
+    yield
+    db.delete(new_agent)
+    db.commit()
+    db.close()
+
+
