+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  margin-bottom: 16px;
+}
+
+.agent-form-grid--credentials {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+
+@media (max-width: 1000px) {
+  .agent-form-grid--identity { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .agent-form-grid--credentials { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+
+@media (max-width: 600px) {
+  #dashboard > .main-content { padding: 14px 12px 28px !important; }
+  .agent-form-grid--identity,
+  .agent-form-grid--credentials { grid-template-columns: minmax(0, 1fr); }
+  .section-block { padding: 16px; }
+  .admin-table-scroll table { min-width: 620px; }
+  .admin-table-scroll[aria-label="Canned responses table"] table { min-width: 500px; }
 }
 
   

